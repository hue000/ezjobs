# 飞书 Base API 配置
# 从飞书开放平台获取：https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 用户个人访问令牌（推荐，绕过应用权限问题）
# 从 https://open.feishu.cn/api-explorer/ 获取（右上角「获取 token」→ 用户身份）
# user_access_token 约 2 小时过期；配置 refresh_token 后会自动续期
FEISHU_USER_ACCESS_TOKEN=u-xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_USER_REFRESH_TOKEN=ur-xxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格配置
# Base Token 和 Table ID 从表格 URL 获取
FEISHU_BASE_TOKEN=EE4zbfKhPaWGSms77zEcJfwwnIE
FEISHU_TABLE_ID=tblAwifxfxgIzlKy

# Google Analytics（可选）
# GA_TRACKING_ID=G-XXXXXXXXXX

# Facebook Pixel（可选）
# FB_PIXEL_ID=XXXXXXXXXXXXXXX
